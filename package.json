{
  "name": "mini-qemu-arm64",
  "version": "1.0.0",
  "type": "module",
  "description": "Educational ARM64 (AArch64) User-Space CPU Emulator & Binary Translators",
  "scripts": {
    "test": "node tools/run_tests.js",
    "ui": "node tools/server.js",
    "serve": "node tools/server.js",
    "start": "node src/emulator.js bin/fib.elf",
    "recompile": "node src/static_recompiler.js",
    "translate": "node src/arm2x86.js bin/fib.elf",
    "build-elfs": "node tools/run_tests.js --build"
  }
}
