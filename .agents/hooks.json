{
  "autonomous-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|bash|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node safety_hook.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_file|edit_file|Write|Edit|write|edit",
        "hooks": [
          {
            "type": "command",
            "command": "node safety_hook.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
